<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- App Store의 '언어' 표기는 이 선언을 읽는다. 템플릿 기본(en)대로 두면
	     전부 한국어인 앱이 스토어에 '영어'로 뜬다 -->
	<key>CFBundleDevelopmentRegion</key>
	<string>ko</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ko</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Offway</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>offway</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<!-- 딥링크는 app_links 가 받는다(DeepLinkListener) — Flutter 3.27+ 의 기본
	     딥링크 처리를 켜 두면 같은 링크를 둘이 다루게 된다 -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kakao$(KAKAO_NATIVE_APP_KEY)</string>
			</array>
		</dict>
		<dict>
			<!-- 위젯을 눌렀을 때 — offway://course/{id} · offway://wizard -->
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>offway</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>kakaokompassauth</string>
		<string>kakaolink</string>
		<string>nmap</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- 로컬 백엔드(http://localhost:8080) 개발용 예외만 둔다 -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- 앱은 위치를 쓰지 않는다(#345) — 권한을 요청하는 코드가 없어 팝업도 뜨지 않는다.
	     그래도 문구는 있어야 한다: 네이버 지도 SDK(NMapsMap·flutter_naver_map)가
	     CLLocationManager 를 참조해, 없으면 App Store 검증 90683 에 걸린다.
	     #345 에서 GPS 와 함께 지웠다가 다시 걸렸다 — 지우지 말 것 -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Offway는 현재 위치를 사용하지 않습니다. 앱에 포함된 지도 기능 때문에 필요한 안내 문구입니다.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>코스 일정 이미지를 사진 앨범에 저장하기 위해 사용합니다.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>코스 일정 이미지를 사진 앨범에 저장하기 위해 사용합니다.</string>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>NSSupportsLiveActivities</key>
	<true/>
</dict>
</plist>
